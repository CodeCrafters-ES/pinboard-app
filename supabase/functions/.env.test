# Variables para el stack LOCAL y para CI. No contiene secretos reales: el valor de
# producción se configura con `supabase secrets set PUSH_WEBHOOK_SECRET=...` y nunca
# se commitea.
#
# Uso: supabase functions serve --env-file supabase/functions/.env.test

PUSH_WEBHOOK_SECRET=local-test-webhook-secret

# Expo apuntando a un puerto cerrado del propio contenedor: los tests NO deben salir
# a exp.host. Además de ser lento y depender de la red, Expo responde
# `DeviceNotRegistered` a los tokens de prueba y la purga los borraría de la base,
# llevándose por delante las filas de las suites que corren en paralelo.
#
# Con el destino inalcanzable, `sendExpoBatch` captura el error, cuenta los fallos y
# no clasifica ningún ticket, así que no purga ni encola nada. Las suites que sí
# ejercitan el envío inyectan su propio doble de `fetch`.
EXPO_PUSH_URL=http://127.0.0.1:9/expo/push
EXPO_RECEIPTS_URL=http://127.0.0.1:9/expo/receipts
